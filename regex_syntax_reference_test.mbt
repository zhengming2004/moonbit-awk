///|
test "GoAWK 1.32 regex syntax 41" {
  let result656 = @awk.run_with_status(
    "BEGIN{p=\"(a{1000}){0}\";print match(\"\",p),RSTART,RLENGTH;print match(\"a\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
  assert_eq(result656.output, "1 1 0\n1 1 0\n1 1 0\n1 1 0\n")
  assert_eq(result656.exit_status, 0)
  let result657 = @awk.run_with_status(
    "BEGIN{print match(\"\",/(a{1000}){0}/),RSTART,RLENGTH;print match(\"a\",/(a{1000}){0}/),RSTART,RLENGTH;print match(\"\",/(a{1000}){0}/),RSTART,RLENGTH;print match(\"\",/(a{1000}){0}/),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
  assert_eq(result657.output, "1 1 0\n1 1 0\n1 1 0\n1 1 0\n")
  assert_eq(result657.exit_status, 0)
  let result658 = @awk.run_with_status(
    "BEGIN{p=\"(a{1000}){1}\";print match(\"\",p),RSTART,RLENGTH;print match(\"a\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
  assert_eq(result658.output, "0 0 -1\n0 0 -1\n1 1 1000\n0 0 -1\n")
  assert_eq(result658.exit_status, 0)
  let result659 = @awk.run_with_status(
    "BEGIN{print match(\"\",/(a{1000}){1}/),RSTART,RLENGTH;print match(\"a\",/(a{1000}){1}/),RSTART,RLENGTH;print match(\"\",/(a{1000}){1}/),RSTART,RLENGTH;print match(\"\",/(a{1000}){1}/),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
  assert_eq(result659.output, "0 0 -1\n0 0 -1\n1 1 1000\n0 0 -1\n")
  assert_eq(result659.exit_status, 0)
  assert_true(
    try {
      ignore(
        @awk.run_with_status(
          "BEGIN{p=\"(a{1000}){2}\";print match(\"\",p),RSTART,RLENGTH;print match(\"a\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH}",
          "",
          separator=" ",
        ),
      )
      false
    } catch {
      _ => true
    },
  )
  assert_true(
    try {
      ignore(
        @awk.run_with_status(
          "BEGIN{print match(\"\",/(a{1000}){2}/),RSTART,RLENGTH;print match(\"a\",/(a{1000}){2}/),RSTART,RLENGTH;print match(\"\",/(a{1000}){2}/),RSTART,RLENGTH;print match(\"\",/(a{1000}){2}/),RSTART,RLENGTH}",
          "",
          separator=" ",
        ),
      )
      false
    } catch {
      _ => true
    },
  )
  let result662 = @awk.run_with_status(
    "BEGIN{p=\"(a{1000})*\";print match(\"\",p),RSTART,RLENGTH;print match(\"a\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
  assert_eq(result662.output, "1 1 0\n1 1 0\n1 1 1000\n1 1 0\n")
  assert_eq(result662.exit_status, 0)
  let result663 = @awk.run_with_status(
    "BEGIN{print match(\"\",/(a{1000})*/),RSTART,RLENGTH;print match(\"a\",/(a{1000})*/),RSTART,RLENGTH;print match(\"\",/(a{1000})*/),RSTART,RLENGTH;print match(\"\",/(a{1000})*/),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
  assert_eq(result663.output, "1 1 0\n1 1 0\n1 1 1000\n1 1 0\n")
  assert_eq(result663.exit_status, 0)
  let result664 = @awk.run_with_status(
    "BEGIN{p=\"(a{1000})+\";print match(\"\",p),RSTART,RLENGTH;print match(\"a\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
  assert_eq(result664.output, "0 0 -1\n0 0 -1\n1 1 1000\n0 0 -1\n")
  assert_eq(result664.exit_status, 0)
  let result665 = @awk.run_with_status(
    "BEGIN{print match(\"\",/(a{1000})+/),RSTART,RLENGTH;print match(\"a\",/(a{1000})+/),RSTART,RLENGTH;print match(\"\",/(a{1000})+/),RSTART,RLENGTH;print match(\"\",/(a{1000})+/),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
  assert_eq(result665.output, "0 0 -1\n0 0 -1\n1 1 1000\n0 0 -1\n")
  assert_eq(result665.exit_status, 0)
  let result666 = @awk.run_with_status(
    "BEGIN{p=\"(a{2}){0,500}\";print match(\"\",p),RSTART,RLENGTH;print match(\"a\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
  assert_eq(result666.output, "1 1 0\n1 1 0\n1 1 1000\n1 1 0\n")
  assert_eq(result666.exit_status, 0)
  let result667 = @awk.run_with_status(
    "BEGIN{print match(\"\",/(a{2}){0,500}/),RSTART,RLENGTH;print match(\"a\",/(a{2}){0,500}/),RSTART,RLENGTH;print match(\"\",/(a{2}){0,500}/),RSTART,RLENGTH;print match(\"\",/(a{2}){0,500}/),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
  assert_eq(result667.output, "1 1 0\n1 1 0\n1 1 1000\n1 1 0\n")
  assert_eq(result667.exit_status, 0)
  assert_true(
    try {
      ignore(
        @awk.run_with_status(
          "BEGIN{p=\"(a{2}){0,501}\";print match(\"\",p),RSTART,RLENGTH;print match(\"a\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH}",
          "",
          separator=" ",
        ),
      )
      false
    } catch {
      _ => true
    },
  )
  assert_true(
    try {
      ignore(
        @awk.run_with_status(
          "BEGIN{print match(\"\",/(a{2}){0,501}/),RSTART,RLENGTH;print match(\"a\",/(a{2}){0,501}/),RSTART,RLENGTH;print match(\"\",/(a{2}){0,501}/),RSTART,RLENGTH;print match(\"\",/(a{2}){0,501}/),RSTART,RLENGTH}",
          "",
          separator=" ",
        ),
      )
      false
    } catch {
      _ => true
    },
  )
  let result670 = @awk.run_with_status(
    "BEGIN{p=\"(a{2}){500,}\";print match(\"\",p),RSTART,RLENGTH;print match(\"a\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH;print match(\"\",p),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
