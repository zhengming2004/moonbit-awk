  )
  assert_eq(result10.exit_status, 0)
  let result11 = @awk.run_with_status(
    "BEGIN{print match(\"\",/a{0,/),RSTART,RLENGTH;print match(\"a\",/a{0,/),RSTART,RLENGTH;print match(\"A\",/a{0,/),RSTART,RLENGTH;print match(\"aa\",/a{0,/),RSTART,RLENGTH;print match(\"aaa\",/a{0,/),RSTART,RLENGTH;print match(\"aaaaaa\",/a{0,/),RSTART,RLENGTH;print match(\"ababa\",/a{0,/),RSTART,RLENGTH;print match(\"ABab\",/a{0,/),RSTART,RLENGTH;print match(\"b\",/a{0,/),RSTART,RLENGTH;print match(\"a\\nb\",/a{0,/),RSTART,RLENGTH;print match(\"a{01}\",/a{0,/),RSTART,RLENGTH;print match(\"a{1001x}\",/a{0,/),RSTART,RLENGTH;print match(\"a{1}\",/a{0,/),RSTART,RLENGTH;print match(\"a{1,2}\",/a{0,/),RSTART,RLENGTH;print match(\"a{2}{01}\",/a{0,/),RSTART,RLENGTH;print match(\"[\",/a{0,/),RSTART,RLENGTH;print match(\"]\",/a{0,/),RSTART,RLENGTH;print match(\":\",/a{0,/),RSTART,RLENGTH;print match(\"x\",/a{0,/),RSTART,RLENGTH;print match(\"-\",/a{0,/),RSTART,RLENGTH;print match(\"1\",/a{0,/),RSTART,RLENGTH;print match(\"a*b\",/a{0,/),RSTART,RLENGTH;print match(\".*[]{}()|^$\",/a{0,/),RSTART,RLENGTH;print match(\"é𐐀𐐀\",/a{0,/),RSTART,RLENGTH}",
