  assert_eq(
    result857.output,
    "8\n1 left\n2 {01}right \n3 {1001x} \n4  A\n5  \n6 {1} :x[ \n7 bbb t\n8 il\n",
  )
  assert_eq(result857.exit_status, 0)
  let result858 = @awk.run_with_status(
    "BEGIN{RS=\"a(?i)+\"}{print NR,\"<\"$0\">\",\"<\"RT\">\"}END{print NR}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator=" ",
  )
  assert_eq(
    result858.output,
    "1 <left> <a>\n2 <{01}right > <a>\n3 <{1001x} > <aaaa>\n4 < A> <aa>\n5 < > <a>\n6 <{1} :x[ > <a>\n7 <bbb t> <a>\n8 <il\n> <>\n8\n",
  )
  assert_eq(result858.exit_status, 0)
  let result859 = @awk.run_with_status(
    "BEGIN{p=\"a*\\\\Q\\\\E+\"}{n=split($0,a,p);print n;for(i=1;i<=n;i++)print i,a[i];s=$0;print sub(p,\"<&>\",s),s;s=$0;print gsub(p,\"<&>\",s),s}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator=" ",
  )
  assert_eq(
    result859.output,
    "40\n1 l\n2 e\n3 f\n4 t\n5 {\n6 0\n7 1\n8 }\n9 r\n10 i\n11 g\n12 h\n13 t\n14  \n15 {\n16 1\n17 0\n18 0\n19 1\n20 x\n21 }\n22  \n23  \n24 A\n25  \n26 {\n27 1\n28 }\n29  \n30 :\n31 x\n32 [\n33  \n34 b\n35 b\n36 b\n37  \n38 t\n39 i\n40 l\n1 <>lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n41 <>l<>e<>f<>t<a>{<>0<>1<>}<>r<>i<>g<>h<>t<> <a>{<>1<>0<>0<>1<>x<>}<> <aaaa> <>A<aa> <a>{<>1<>}<> <>:<>x<>[<> <a>b<>b<>b<> <>t<a>i<>l<>\n",
  )
  assert_eq(result859.exit_status, 0)
  let result860 = @awk.run_with_status(
    "{print NF;for(i=1;i<=NF;i++)print i,$i}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator="a*\\Q\\E+",
  )
  assert_eq(
    result860.output,
    "8\n1 left\n2 {01}right \n3 {1001x} \n4  A\n5  \n6 {1} :x[ \n7 bbb t\n8 il\n",
  )
  assert_eq(result860.exit_status, 0)
  let result861 = @awk.run_with_status(
    "BEGIN{RS=\"a*\\\\Q\\\\E+\"}{print NR,\"<\"$0\">\",\"<\"RT\">\"}END{print NR}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator=" ",
  )
  assert_eq(
    result861.output,
    "1 <lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n> <>\n1\n",
  )
  assert_eq(result861.exit_status, 0)
  let result862 = @awk.run_with_status(
    "BEGIN{p=\"a{\\\\Q1\\\\E}\"}{n=split($0,a,p);print n;for(i=1;i<=n;i++)print i,a[i];s=$0;print sub(p,\"<&>\",s),s;s=$0;print gsub(p,\"<&>\",s),s}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator=" ",
  )
  assert_eq(
    result862.output,
    "2\n1 lefta{01}right a{1001x} aaaa Aaa \n2  :x[ abbb tail\n1 lefta{01}right a{1001x} aaaa Aaa <a{1}> :x[ abbb tail\n1 lefta{01}right a{1001x} aaaa Aaa <a{1}> :x[ abbb tail\n",
  )
  assert_eq(result862.exit_status, 0)
  let result863 = @awk.run_with_status(
    "{print NF;for(i=1;i<=NF;i++)print i,$i}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator="a{\\Q1\\E}",
  )
  assert_eq(
    result863.output,
    "2\n1 lefta{01}right a{1001x} aaaa Aaa \n2  :x[ abbb tail\n",
  )
  assert_eq(result863.exit_status, 0)
}

///|
test "GoAWK 1.32 regex syntax 54" {
  let result864 = @awk.run_with_status(
    "BEGIN{RS=\"a{\\\\Q1\\\\E}\"}{print NR,\"<\"$0\">\",\"<\"RT\">\"}END{print NR}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator=" ",
  )
  assert_eq(
    result864.output,
    "1 <lefta{01}right a{1001x} aaaa Aaa > <a{1}>\n2 < :x[ abbb tail\n> <>\n2\n",
  )
  assert_eq(result864.exit_status, 0)
  let result865 = @awk.run_with_status(
    "BEGIN{p=\"[[:]\"}{n=split($0,a,p);print n;for(i=1;i<=n;i++)print i,a[i];s=$0;print sub(p,\"<&>\",s),s;s=$0;print gsub(p,\"<&>\",s),s}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator=" ",
  )
  assert_eq(
    result865.output,
    "3\n1 lefta{01}right a{1001x} aaaa Aaa a{1} \n2 x\n3  abbb tail\n1 lefta{01}right a{1001x} aaaa Aaa a{1} <:>x[ abbb tail\n2 lefta{01}right a{1001x} aaaa Aaa a{1} <:>x<[> abbb tail\n",
  )
  assert_eq(result865.exit_status, 0)
  let result866 = @awk.run_with_status(
    "{print NF;for(i=1;i<=NF;i++)print i,$i}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator="[[:]",
  )
  assert_eq(
    result866.output,
    "3\n1 lefta{01}right a{1001x} aaaa Aaa a{1} \n2 x\n3  abbb tail\n",
  )
  assert_eq(result866.exit_status, 0)
  let result867 = @awk.run_with_status(
    "BEGIN{RS=\"[[:]\"}{print NR,\"<\"$0\">\",\"<\"RT\">\"}END{print NR}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator=" ",
  )
  assert_eq(
    result867.output,
    "1 <lefta{01}right a{1001x} aaaa Aaa a{1} > <:>\n2 <x> <[>\n3 < abbb tail\n> <>\n3\n",
  )
  assert_eq(result867.exit_status, 0)
  let result868 = @awk.run_with_status(
    "BEGIN{p=\"[[:x]]\"}{n=split($0,a,p);print n;for(i=1;i<=n;i++)print i,a[i];s=$0;print sub(p,\"<&>\",s),s;s=$0;print gsub(p,\"<&>\",s),s}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator=" ",
  )
  assert_eq(
    result868.output,
    "1\n1 lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n0 lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n0 lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
  )
  assert_eq(result868.exit_status, 0)
  let result869 = @awk.run_with_status(
    "{print NF;for(i=1;i<=NF;i++)print i,$i}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator="[[:x]]",
  )
  assert_eq(
    result869.output,
    "1\n1 lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
  )
  assert_eq(result869.exit_status, 0)
  let result870 = @awk.run_with_status(
    "BEGIN{RS=\"[[:x]]\"}{print NR,\"<\"$0\">\",\"<\"RT\">\"}END{print NR}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator=" ",
  )
  assert_eq(
    result870.output,
    "1 <lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n> <>\n1\n",
  )
  assert_eq(result870.exit_status, 0)
  let result871 = @awk.run_with_status(
    "BEGIN{p=\"\\\\Qab\\\\E+\"}{n=split($0,a,p);print n;for(i=1;i<=n;i++)print i,a[i];s=$0;print sub(p,\"<&>\",s),s;s=$0;print gsub(p,\"<&>\",s),s}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator=" ",
  )
  assert_eq(
    result871.output,
    "2\n1 lefta{01}right a{1001x} aaaa Aaa a{1} :x[ \n2  tail\n1 lefta{01}right a{1001x} aaaa Aaa a{1} :x[ <abbb> tail\n1 lefta{01}right a{1001x} aaaa Aaa a{1} :x[ <abbb> tail\n",
  )
  assert_eq(result871.exit_status, 0)
  let result872 = @awk.run_with_status(
    "{print NF;for(i=1;i<=NF;i++)print i,$i}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator="\\Qab\\E+",
  )
  assert_eq(
    result872.output,
    "2\n1 lefta{01}right a{1001x} aaaa Aaa a{1} :x[ \n2  tail\n",
  )
  assert_eq(result872.exit_status, 0)
  let result873 = @awk.run_with_status(
    "BEGIN{RS=\"\\\\Qab\\\\E+\"}{print NR,\"<\"$0\">\",\"<\"RT\">\"}END{print NR}",
    "lefta{01}right a{1001x} aaaa Aaa a{1} :x[ abbb tail\n",
    separator=" ",
  )
  assert_eq(
    result873.output,
    "1 <lefta{01}right a{1001x} aaaa Aaa a{1} :x[ > <abbb>\n2 < tail\n> <>\n2\n",
  )
  assert_eq(result873.exit_status, 0)
  let result874 = @awk.run_with_status(
    "{print NR,NF;for(i=1;i<=NF;i++)print i,\"<\"$i\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator="a*",
  )
  assert_eq(
    result874.output,
    "1 2\n1 <>\n2 <bc>\n2 2\n1 <>\n2 <>\n3 2\n1 <x>\n2 <x>\n4 0\n5 2\n1 <é𐐀>\n2 <é>\n",
  )
  assert_eq(result874.exit_status, 0)
  let result875 = @awk.run_with_status(
    "{n=split($0,a,\"a*\");print NR,n;for(i=1;i<=n;i++)print i,\"<\"a[i]\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator=" ",
  )
  assert_eq(
    result875.output,
    "1 3\n1 <>\n2 <b>\n3 <c>\n2 2\n1 <>\n2 <>\n3 2\n1 <x>\n2 <x>\n4 0\n5 3\n1 <é>\n2 <𐐀>\n3 <é>\n",
  )
  assert_eq(result875.exit_status, 0)
  let result876 = @awk.run_with_status(
    "{print NR,NF;for(i=1;i<=NF;i++)print i,\"<\"$i\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator="a?",
  )
  assert_eq(
    result876.output,
    "1 2\n1 <>\n2 <bc>\n2 4\n1 <>\n2 <>\n3 <>\n4 <>\n3 4\n1 <x>\n2 <>\n3 <>\n4 <x>\n4 0\n5 2\n1 <é𐐀>\n2 <é>\n",
  )
  assert_eq(result876.exit_status, 0)
  let result877 = @awk.run_with_status(
    "{n=split($0,a,\"a?\");print NR,n;for(i=1;i<=n;i++)print i,\"<\"a[i]\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator=" ",
  )
  assert_eq(
    result877.output,
    "1 3\n1 <>\n2 <b>\n3 <c>\n2 4\n1 <>\n2 <>\n3 <>\n4 <>\n3 4\n1 <x>\n2 <>\n3 <>\n4 <x>\n4 0\n5 3\n1 <é>\n2 <𐐀>\n3 <é>\n",
  )
  assert_eq(result877.exit_status, 0)
  let result878 = @awk.run_with_status(
    "{print NR,NF;for(i=1;i<=NF;i++)print i,\"<\"$i\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator="x*",
  )
  assert_eq(
    result878.output,
    "1 1\n1 <abc>\n2 1\n1 <aaa>\n3 3\n1 <>\n2 <aaa>\n3 <>\n4 0\n5 1\n1 <é𐐀aé>\n",
  )
  assert_eq(result878.exit_status, 0)
  let result879 = @awk.run_with_status(
    "{n=split($0,a,\"x*\");print NR,n;for(i=1;i<=n;i++)print i,\"<\"a[i]\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator=" ",
  )
  assert_eq(
    result879.output,
    "1 3\n1 <a>\n2 <b>\n3 <c>\n2 3\n1 <a>\n2 <a>\n3 <a>\n3 5\n1 <>\n2 <a>\n3 <a>\n4 <a>\n5 <>\n4 0\n5 4\n1 <é>\n2 <𐐀>\n3 <a>\n4 <é>\n",
  )
  assert_eq(result879.exit_status, 0)
}

///|
test "GoAWK 1.32 regex syntax 55" {
  let result880 = @awk.run_with_status(
    "{print NR,NF;for(i=1;i<=NF;i++)print i,\"<\"$i\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator="^",
  )
  assert_eq(
    result880.output,
    "1 1\n1 <abc>\n2 1\n1 <aaa>\n3 1\n1 <xaaax>\n4 0\n5 1\n1 <é𐐀aé>\n",
  )
  assert_eq(result880.exit_status, 0)
  let result881 = @awk.run_with_status(
    "{n=split($0,a,\"^\");print NR,n;for(i=1;i<=n;i++)print i,\"<\"a[i]\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator=" ",
  )
  assert_eq(
    result881.output,
    "1 1\n1 <abc>\n2 1\n1 <aaa>\n3 1\n1 <xaaax>\n4 0\n5 1\n1 <é𐐀aé>\n",
  )
  assert_eq(result881.exit_status, 0)
  let result882 = @awk.run_with_status(
    "{print NR,NF;for(i=1;i<=NF;i++)print i,\"<\"$i\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator="$",
  )
  assert_eq(
    result882.output,
    "1 1\n1 <abc>\n2 1\n1 <aaa>\n3 1\n1 <xaaax>\n4 0\n5 1\n1 <é𐐀aé>\n",
  )
  assert_eq(result882.exit_status, 0)
  let result883 = @awk.run_with_status(
    "{n=split($0,a,\"$\");print NR,n;for(i=1;i<=n;i++)print i,\"<\"a[i]\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator=" ",
  )
  assert_eq(
    result883.output,
    "1 1\n1 <abc>\n2 1\n1 <aaa>\n3 1\n1 <xaaax>\n4 0\n5 1\n1 <é𐐀aé>\n",
  )
  assert_eq(result883.exit_status, 0)
  let result884 = @awk.run_with_status(
    "{print NR,NF;for(i=1;i<=NF;i++)print i,\"<\"$i\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator="^|$",
  )
  assert_eq(
    result884.output,
    "1 1\n1 <abc>\n2 1\n1 <aaa>\n3 1\n1 <xaaax>\n4 0\n5 1\n1 <é𐐀aé>\n",
  )
  assert_eq(result884.exit_status, 0)
  let result885 = @awk.run_with_status(
    "{n=split($0,a,\"^|$\");print NR,n;for(i=1;i<=n;i++)print i,\"<\"a[i]\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator=" ",
  )
  assert_eq(
    result885.output,
    "1 1\n1 <abc>\n2 1\n1 <aaa>\n3 1\n1 <xaaax>\n4 0\n5 1\n1 <é𐐀aé>\n",
  )
  assert_eq(result885.exit_status, 0)
  let result886 = @awk.run_with_status(
    "{print NR,NF;for(i=1;i<=NF;i++)print i,\"<\"$i\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator="a|",
  )
  assert_eq(
    result886.output,
    "1 2\n1 <>\n2 <bc>\n2 4\n1 <>\n2 <>\n3 <>\n4 <>\n3 4\n1 <x>\n2 <>\n3 <>\n4 <x>\n4 0\n5 2\n1 <é𐐀>\n2 <é>\n",
  )
  assert_eq(result886.exit_status, 0)
  let result887 = @awk.run_with_status(
    "{n=split($0,a,\"a|\");print NR,n;for(i=1;i<=n;i++)print i,\"<\"a[i]\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator=" ",
  )
  assert_eq(
    result887.output,
    "1 3\n1 <>\n2 <b>\n3 <c>\n2 4\n1 <>\n2 <>\n3 <>\n4 <>\n3 4\n1 <x>\n2 <>\n3 <>\n4 <x>\n4 0\n5 3\n1 <é>\n2 <𐐀>\n3 <é>\n",
  )
  assert_eq(result887.exit_status, 0)
  let result888 = @awk.run_with_status(
    "{print NR,NF;for(i=1;i<=NF;i++)print i,\"<\"$i\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator="a{0}",
  )
  assert_eq(
    result888.output,
    "1 1\n1 <abc>\n2 1\n1 <aaa>\n3 1\n1 <xaaax>\n4 0\n5 1\n1 <é𐐀aé>\n",
  )
  assert_eq(result888.exit_status, 0)
  let result889 = @awk.run_with_status(
    "{n=split($0,a,\"a{0}\");print NR,n;for(i=1;i<=n;i++)print i,\"<\"a[i]\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator=" ",
  )
  assert_eq(
    result889.output,
    "1 3\n1 <a>\n2 <b>\n3 <c>\n2 3\n1 <a>\n2 <a>\n3 <a>\n3 5\n1 <x>\n2 <a>\n3 <a>\n4 <a>\n5 <x>\n4 0\n5 4\n1 <é>\n2 <𐐀>\n3 <a>\n4 <é>\n",
  )
  assert_eq(result889.exit_status, 0)
  let result890 = @awk.run_with_status(
    "{print NR,NF;for(i=1;i<=NF;i++)print i,\"<\"$i\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator="a*\\Q\\E+",
  )
  assert_eq(
    result890.output,
    "1 2\n1 <>\n2 <bc>\n2 2\n1 <>\n2 <>\n3 2\n1 <x>\n2 <x>\n4 0\n5 2\n1 <é𐐀>\n2 <é>\n",
  )
  assert_eq(result890.exit_status, 0)
  let result891 = @awk.run_with_status(
    "{n=split($0,a,\"a*\\\\Q\\\\E+\");print NR,n;for(i=1;i<=n;i++)print i,\"<\"a[i]\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator=" ",
  )
  assert_eq(
    result891.output,
    "1 3\n1 <>\n2 <b>\n3 <c>\n2 2\n1 <>\n2 <>\n3 2\n1 <x>\n2 <x>\n4 0\n5 3\n1 <é>\n2 <𐐀>\n3 <é>\n",
  )
  assert_eq(result891.exit_status, 0)
  let result892 = @awk.run_with_status(
    "{print NR,NF;for(i=1;i<=NF;i++)print i,\"<\"$i\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator="(?i)a*",
  )
  assert_eq(
    result892.output,
    "1 2\n1 <>\n2 <bc>\n2 2\n1 <>\n2 <>\n3 2\n1 <x>\n2 <x>\n4 0\n5 2\n1 <é𐐀>\n2 <é>\n",
  )
  assert_eq(result892.exit_status, 0)
  let result893 = @awk.run_with_status(
    "{n=split($0,a,\"(?i)a*\");print NR,n;for(i=1;i<=n;i++)print i,\"<\"a[i]\">\"}",
    "abc\naaa\nxaaax\n\né𐐀aé\n",
    separator=" ",
  )
  assert_eq(
    result893.output,
    "1 3\n1 <>\n2 <b>\n3 <c>\n2 2\n1 <>\n2 <>\n3 2\n1 <x>\n2 <x>\n4 0\n5 3\n1 <é>\n2 <𐐀>\n3 <é>\n",
  )
  assert_eq(result893.exit_status, 0)
}
