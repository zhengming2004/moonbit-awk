test "GoAWK 1.32 regex syntax 8" {
  let result128 = @awk.run_with_status(
    "BEGIN{p=\"a{2}\";print match(\"\",p),RSTART,RLENGTH;print match(\"a\",p),RSTART,RLENGTH;print match(\"A\",p),RSTART,RLENGTH;print match(\"aa\",p),RSTART,RLENGTH;print match(\"aaa\",p),RSTART,RLENGTH;print match(\"aaaaaa\",p),RSTART,RLENGTH;print match(\"ababa\",p),RSTART,RLENGTH;print match(\"ABab\",p),RSTART,RLENGTH;print match(\"b\",p),RSTART,RLENGTH;print match(\"a\\nb\",p),RSTART,RLENGTH;print match(\"a{01}\",p),RSTART,RLENGTH;print match(\"a{1001x}\",p),RSTART,RLENGTH;print match(\"a{1}\",p),RSTART,RLENGTH;print match(\"a{1,2}\",p),RSTART,RLENGTH;print match(\"a{2}{01}\",p),RSTART,RLENGTH;print match(\"[\",p),RSTART,RLENGTH;print match(\"]\",p),RSTART,RLENGTH;print match(\":\",p),RSTART,RLENGTH;print match(\"x\",p),RSTART,RLENGTH;print match(\"-\",p),RSTART,RLENGTH;print match(\"1\",p),RSTART,RLENGTH;print match(\"a*b\",p),RSTART,RLENGTH;print match(\".*[]{}()|^$\",p),RSTART,RLENGTH;print match(\"é𐐀𐐀\",p),RSTART,RLENGTH}",
