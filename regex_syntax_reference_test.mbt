    "BEGIN{print match(\"\",/a{1000x}/),RSTART,RLENGTH;print match(\"a\",/a{1000x}/),RSTART,RLENGTH;print match(\"A\",/a{1000x}/),RSTART,RLENGTH;print match(\"aa\",/a{1000x}/),RSTART,RLENGTH;print match(\"aaa\",/a{1000x}/),RSTART,RLENGTH;print match(\"aaaaaa\",/a{1000x}/),RSTART,RLENGTH;print match(\"ababa\",/a{1000x}/),RSTART,RLENGTH;print match(\"ABab\",/a{1000x}/),RSTART,RLENGTH;print match(\"b\",/a{1000x}/),RSTART,RLENGTH;print match(\"a\\nb\",/a{1000x}/),RSTART,RLENGTH;print match(\"a{01}\",/a{1000x}/),RSTART,RLENGTH;print match(\"a{1001x}\",/a{1000x}/),RSTART,RLENGTH;print match(\"a{1}\",/a{1000x}/),RSTART,RLENGTH;print match(\"a{1,2}\",/a{1000x}/),RSTART,RLENGTH;print match(\"a{2}{01}\",/a{1000x}/),RSTART,RLENGTH;print match(\"[\",/a{1000x}/),RSTART,RLENGTH;print match(\"]\",/a{1000x}/),RSTART,RLENGTH;print match(\":\",/a{1000x}/),RSTART,RLENGTH;print match(\"x\",/a{1000x}/),RSTART,RLENGTH;print match(\"-\",/a{1000x}/),RSTART,RLENGTH;print match(\"1\",/a{1000x}/),RSTART,RLENGTH;print match(\"a*b\",/a{1000x}/),RSTART,RLENGTH;print match(\".*[]{}()|^$\",/a{1000x}/),RSTART,RLENGTH;print match(\"é𐐀𐐀\",/a{1000x}/),RSTART,RLENGTH}",
    "",
    separator=" ",
  )
