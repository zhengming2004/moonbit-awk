///|
test "GoAWK Unicode string scalar batch 1" {
  assert_eq(
    @awk.run(
      "BEGIN{for(i=32768;i<34816;i++){if(i>=55296&&i<=57343)continue;s=sprintf(\"%c\",i);printf \"%s%s\",tolower(s),toupper(s)}}",
